{
  "name": "@hx/ui-monorepo",
  "version": "0.0.1",
  "private": true,
  "description": "基于 Vue 3 + TypeScript + Element Plus 的业务组件二次封装库 monorepo",
  "license": "ISC",
  "author": "hx-admin",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build:ui": "pnpm --filter @hx/ui run build",
    "version:pkg": "pnpm --filter @hx/ui run version",
    "publish:ui": "pnpm --filter @hx/ui run publish-pkg",
    "release": "pnpm run build:ui && pnpm run version:pkg && pnpm run publish:ui",
    "docs:dev": "vitepress dev docs --host --port 4001",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host --port 4001",
    "play:dev": "pnpm --filter play dev",
    "play:build": "pnpm --filter play build",
    "play:preview": "pnpm --filter play preview",
    "server:dev": "pnpm --filter @hx/ui-server dev",
    "server:build": "pnpm --filter @hx/ui-server build",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@hx/ui": "workspace:*",
    "@iconify/json": "^2.2.458",
    "@iconify/types": "^2.0.0",
    "@iconify/vue": "^5.0.0",
    "@rolldown/binding-win32-x64-msvc": "1.0.0-rc.9",
    "@rollup/rollup-win32-x64-msvc": "4.59.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.0",
    "@types/qrcode": "^1.5.6",
    "@unocss/preset-attributify": "^66.6.6",
    "@unocss/preset-icons": "^66.6.6",
    "@unocss/preset-uno": "^66.6.6",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "element-plus": "^2.13.5",
    "sass-embedded": "^1.99.0",
    "typescript": "~5.9.3",
    "unocss": "^66.6.6",
    "vite": "^8.0.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.30"
  }
}
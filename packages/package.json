{
  "name": "@hx/ui",
  "version": "0.0.11",
  "description": "基于 Vue 3 + TypeScript + Element Plus 的业务组件库",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "import": "./dist/*"
    },
    "./*": {
      "import": "./dist/*"
    },
    "./index.css": {
      "import": "./dist/index.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "node -e \"fs.rmSync('dist', {recursive:true, force:true})\" && node ../node_modules/vite/bin/vite.js build",
    "publish-pkg": "node scripts/publish.js",
    "version": "node scripts/version.js"
  },
  "peerDependencies": {
    "@antv/g6": ">=5.0.0",
    "@element-plus/icons-vue": ">=2.3.1",
    "@iconify/vue": ">=4.3.0",
    "element-plus": ">=2.9.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "@antv/g6": {
      "optional": true
    },
    "qrcode": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "ol": {
      "optional": true
    },
    "ol-layerswitcher": {
      "optional": true
    }
  },
  "dependencies": {
    "ol-layerswitcher": "^4.1.2"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5"
  }
}

{
  "name": "@hx/ui",
  "version": "0.0.11",
  "description": "基于 Vue 3 + TypeScript + Element Plus 的业务组件库",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./components/text": {
      "types": "./dist/components/text/types.d.ts",
      "import": "./dist/components/text/text.vue.js"
    },
    "./components/json-view": {
      "types": "./dist/components/json-view/index.d.ts",
      "import": "./dist/components/json-view/JsonView.vue.js"
    },
    "./components/card-list": {
      "types": "./dist/components/card-list/index.d.ts",
      "import": "./dist/components/card-list/CardList.vue.js"
    },
    "./components/table": {
      "types": "./dist/components/table/types.d.ts",
      "import": "./dist/components/table/Table.vue.js"
    },
    "./components/filter-item": {
      "types": "./dist/components/filter-panel/types.d.ts",
      "import": "./dist/components/filter-panel/FilterItem.vue.js"
    },
    "./components/filter-date-range": {
      "types": "./dist/components/filter-panel/types.d.ts",
      "import": "./dist/components/filter-panel/FilterDateRange.vue.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vue-tsc --declaration --emitDeclarationOnly --noEmit true && vite build",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": ">=2.3.1",
    "@iconify/vue": ">=4.3.0",
    "element-plus": ">=2.9.0",
    "vue": ">=3.5.0"
  },
  "peerDependenciesMeta": {
    "qrcode": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.5"
  }
}